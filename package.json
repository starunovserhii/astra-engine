{
  "name": "astra-engine",
  "version": "0.1.0",
  "description": "ASTRA astrological calculation engine — astronomical core (astronomy-engine, MIT) + custom astrological layer (houses, aspects, chart types).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "test": "tsx src/__tests__/run.ts",
    "demo": "tsx src/__tests__/demo.ts",
    "build:bundle": "esbuild src/index.ts --bundle --format=iife --global-name=AstraEngine --outfile=astra-engine.bundle.js --platform=browser --minify",
    "build:site": "node scripts/build-site.mjs"
  },
  "keywords": ["astrology", "astronomy", "natal-chart", "ephemeris"],
  "author": "",
  "dependencies": {
    "astronomy-engine": "^2.1.19"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
